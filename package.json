{
  "name": "packmule",
  "productName": "Packmule",
  "version": "0.1.0",
  "description": "Install and update World of Warcraft addons from GitHub releases",
  "author": {
    "name": "hammackj",
    "email": "hammackj@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/hammackj/packmule",
  "repository": {
    "type": "git",
    "url": "https://github.com/hammackj/packmule.git"
  },
  "desktopName": "packmule.desktop",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "install-electron",
    "dist": "electron-vite build && electron-builder --linux",
    "catalog": "node scripts/update-catalog.mjs"
  },
  "build": {
    "appId": "io.github.hammackj.packmule",
    "productName": "Packmule",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "packaging/packmule-256.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "executableName": "packmule",
      "icon": "packaging/packmule-512.png",
      "category": "Game",
      "synopsis": "World of Warcraft addon manager",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "hammackj",
      "repo": "packmule",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  }
}
